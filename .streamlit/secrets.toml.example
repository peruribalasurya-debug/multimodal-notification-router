# Copy this file to .streamlit/secrets.toml (untracked -- see .gitignore) and
# fill in a real key to enable the cascade/full-LLM modes in app.py.
# Without this, the demo still runs end-to-end in rules-only mode.
#
# Streamlit reads .streamlit/secrets.toml server-side only -- it is never sent
# to the browser. On Streamlit Community Cloud, set this instead via the app's
# Settings -> Secrets panel.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
