# Copy this file to .env and fill in your key, or export the variables directly in
# your shell. Never commit a real .env file.

# Required for the primary LLM-based classification path (src/router.py) and the
# LLM-vision image extraction path (src/media.py). If unset, the router falls back to
# a deterministic rule-based classifier for every message and image extraction falls
# back to local Tesseract OCR (text only, no visual description) -- the pipeline still
# runs and produces a valid output.csv either way.
ANTHROPIC_API_KEY=

# Optional overrides -- sensible defaults are used if omitted.

# Claude model used for classification/routing and image-vision extraction. Defaults to
# claude-haiku-4-5 (cheapest current model) so iteration runs stay cheap. Override to a
# bigger model for a final validation run, e.g.:
#   ROUTER_MODEL=claude-opus-5 python -m src.eval
# ROUTER_MODEL=claude-haiku-4-5

# faster-whisper model size used for voice-note transcription.
# ROUTER_WHISPER_MODEL=base

# Explicit path to the tesseract.exe binary, if it isn't on PATH and isn't in one of
# the standard install locations src/media.py already checks (Program Files, or
# %LOCALAPPDATA%\Tesseract-OCR for a no-admin-rights install).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
